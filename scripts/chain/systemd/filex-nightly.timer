# When the nightly starts. A template: scripts/chain/install-nightly.sh
# fills @AT@ (default "02:00 Europe/Istanbul": a calendar time and a time
# zone, see systemd.time(7)). Not Persistent: a host that was off at that
# hour does not push in the morning, when the release work wants GitHub's
# runners.
[Unit]
Description=filex nightly, every night at @AT@

[Timer]
OnCalendar=*-*-* @AT@
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
