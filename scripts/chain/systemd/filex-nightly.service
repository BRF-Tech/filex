# The nightly (scripts/chain/nightly.mjs, tasks #175 and #361): the private
# main, exported the way a release is and pushed to the public repository's
# `nightly` branch, where GitHub tests it and builds from it.
# A template: scripts/chain/install-nightly.sh fills @NODE@, @BIN@ and @ENV@
# and installs it as /etc/systemd/system/filex-nightly.service. Started by
# filex-nightly.timer; `systemctl start filex-nightly.service` runs a night
# by hand (it does nothing when main has not moved: `nightly.mjs run --force`).
[Unit]
Description=filex nightly: main exported and pushed to the nightly branch (scripts/chain/nightly.mjs)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# git, docker and the export read their settings from a home directory.
Environment=HOME=/root
ExecStart=@NODE@ @BIN@/nightly.mjs run --env @ENV@
# 1 is an export that refused the change, or a push that failed: recorded and
# said in the morning report, not a failed unit.
SuccessExitStatus=1
# The export and the push take minutes; this is only the backstop.
TimeoutStartSec=1h
Nice=5
