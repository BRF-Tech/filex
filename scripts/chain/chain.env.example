# Settings for scripts/chain/run.sh: copy to ~/.config/filex-chain.env (or
# pass --env FILE). KEY=VALUE, no expansion; the process environment wins
# over this file. Every key is optional.

# Where runs, caches and the default lock live.
CHAIN_ROOT=/var/lib/filex-chain
# The lock every build on this host takes (`none`: no lock). run.sh waits for
# it as long as it takes, or CHAIN_LOCK_WAIT_MIN minutes when the PROCESS
# environment sets that (run.sh reads no file; it exits 3 when the time is up).
# CHAIN_LOCK=/var/lib/filex-chain/lock
# Names of the containers, networks and sidecars (one run per prefix at a time).
# CHAIN_PREFIX=fxchain

# Memory, in GiB. The budget the chain's jobs may hold at once (by their
# measured peak resident memory, scripts/chain/plan.mjs WEIGHTS), and the
# MemAvailable a job leaves free before it starts. Size CHAIN_MEM_GB to the
# MemAvailable this host shows when the chain is not running.
# CHAIN_MEM_GB=8
# CHAIN_MEM_RESERVE_GB=1
# CHAIN_POOL_MAX=3
# CHAIN_CPUS=12

# Caches shared between runs (default: $CHAIN_ROOT/cache/...). The Go jobs
# run as CHAIN_GO_USER (default 1000:1000) with CHAIN_GOCACHE, the build as
# root with CHAIN_GOCACHE_ROOT; one directory serves both only when its
# subdirectories already belong to that user.
# CHAIN_GOMODCACHE=  CHAIN_GOCACHE=  CHAIN_GOCACHE_ROOT=  CHAIN_PNPM_STORE=
# CHAIN_CYPRESS_CACHE=  CHAIN_ELECTRON_CACHE=  CHAIN_HOME=  CHAIN_GOROOT=
# CHAIN_GO_USER=1000:1000

# Images (defaults: the Playwright of pnpm-lock.yaml, the Go of
# backend/go.mod, the S3 gateway e2e/lib/s3server.mjs pins).
# CHAIN_DS_IMAGE=onlyoffice/documentserver:latest
# CHAIN_PW_IMAGE=  CHAIN_GO_IMAGE=  CHAIN_NODE_IMAGE=  CHAIN_S3_IMAGE=
# CHAIN_PG_IMAGE=  CHAIN_MYSQL_IMAGE=  CHAIN_REDIS_IMAGE=  CHAIN_SMB_IMAGE=
# The Document Server's own network (a free /24 on this host).
# CHAIN_DS_SUBNET=172.30.81.0/24

# The app builds the browser suite installs. A spec whose build is missing is
# red (FILEX_REQUIRE_WASM_FIXTURE=1, as on CI); CHAIN_REQUIRE_APPS=0 lets
# those specs skip instead.
# CHAIN_SIGN_APP_DIR=/path/to/filex-sign/dist
# CHAIN_CONVERT_APP_DIR=/path/to/filex-convert
# CHAIN_LANG_ES_DIR=/path/to/filex-lang-es
# CHAIN_LANG_DE_DIR=/path/to/filex-lang-de
# CHAIN_LANG_FR_DIR=/path/to/filex-lang-fr
# CHAIN_LANG_AR_DIR=/path/to/filex-lang-ar
# CHAIN_REQUIRE_APPS=1

# A disk that throttles when hot: before every Playwright job the chain waits
# (at most CHAIN_TEMP_WAIT_MIN) until this Prometheus query is at most
# CHAIN_TEMP_MAX degrees.
# CHAIN_TEMP_PROM=http://127.0.0.1:9090
# CHAIN_TEMP_QUERY=max(node_hwmon_temp_celsius{chip=~".*nvme.*"})
# CHAIN_TEMP_MAX=72

# Where the end of a run is posted: a JSON POST with a Bearer key read from
# CHAIN_NOTIFY_KEY_FILE (never logged). Unset = no post.
# CHAIN_NOTIFY_URL=https://notify.example.com/api/notify/v1/send
# CHAIN_NOTIFY_KEY_FILE=/var/lib/filex-chain/notify.key
# CHAIN_NOTIFY_GROUP=infra
# CHAIN_NOTIFY_SOURCE=filex-chain

# The nightly profile's extras (ds-go, s3-live, shots, realenv) and the
# nightly run that starts it: scripts/chain/nightly.env.example (s3-live's
# FILEX_TEST_S3_* settings are there too).
# CHAIN_NIGHTLY_EXTRAS=ds-go,s3-live,shots,realenv
# The same extras on a targeted run, by name (none by default): s3-live with
# FILEX_TEST_S3_* is the live S3 tests by hand (scripts/chain/nightly.mjs s3-live).
# CHAIN_EXTRAS=s3-live

# Other lists: a path, or cmd:<command> whose output is a list in the same
# format. The Go and -race jobs default to the shards of
# scripts/test-shards.json (cmd:node scripts/test-shards.mjs go --profile
# go|race --format chain), the browser round to scripts/chain/lists/e2e.txt.
# CHAIN_GO_LIST=  CHAIN_RACE_LIST=  CHAIN_E2E_LIST=
