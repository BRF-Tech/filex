# When the autonomous release round's morning report goes out. A template:
# scripts/train/install-auto.sh fills @REPORT_AT@ (default
# "07:00 Europe/Istanbul").
[Unit]
Description=filex autonomous release round: the morning report at @REPORT_AT@

[Timer]
OnCalendar=*-*-* @REPORT_AT@
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
