        <!--
          Microsoft Store (MSIX) registrations. electron-builder pastes this file
          inside <Application><Extensions> (appx.customExtensionsPath); the uap3
          and uap10 namespaces are added by scripts/appx-manifest.cjs.

          An MSIX package cannot register anything at runtime: HKCU writes land in
          the package's private hive, where no other app looks. So the three
          things the other builds register as they run (the filex:// link, "Open
          with filex", the login item) are declared here instead.
        -->

        <!-- The browser sign-in comes back through filex://. `Parameters`
             passes the link as argv[1], exactly as the NSIS build's registry
             command does, so classifyArgv (src/openwith.ts) reads both the same. -->
        <uap3:Extension Category="windows.protocol">
          <uap3:Protocol Name="filex" Parameters="&quot;%1&quot;">
            <uap:DisplayName>filex</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>

        <!-- "Open with filex". ⚠ An MSIX file-type registration only puts the
             app in the "Open with" list — it never takes the default (Microsoft:
             the app "appears in the suggested apps"), which is the same promise
             build/installer.nsh keeps for the NSIS build.
             ⚠ The extension list is OFFICE_EXTENSIONS (src/openwith.ts);
             desktop/test/extension-lists.test.ts fails if the two disagree. -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="filex.office" Parameters="&quot;%1&quot;">
            <uap:DisplayName>filex</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.docx</uap:FileType>
              <uap:FileType>.doc</uap:FileType>
              <uap:FileType>.xlsx</uap:FileType>
              <uap:FileType>.xls</uap:FileType>
              <uap:FileType>.pptx</uap:FileType>
              <uap:FileType>.ppt</uap:FileType>
              <uap:FileType>.odt</uap:FileType>
              <uap:FileType>.ods</uap:FileType>
              <uap:FileType>.odp</uap:FileType>
              <uap:FileType>.rtf</uap:FileType>
              <uap:FileType>.csv</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <!-- Every other kind the app store's apps open (build/app-kinds.json).
             A package cannot register a type while it runs, so the package
             declares them all, and the app says at the double-click when none
             of the person's servers opens one (src/os-assoc.ts). Written by
             the build (scripts/app-kinds.mjs), never by hand. -->
        <!-- >>> app-kinds: store (generated by scripts/app-kinds.mjs from build/app-kinds.json, do not edit) -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="filex.apps" Parameters="&quot;%1&quot;">
            <uap:DisplayName>filex</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.af</uap:FileType>
              <uap:FileType>.afdesign</uap:FileType>
              <uap:FileType>.afphoto</uap:FileType>
              <uap:FileType>.afpub</uap:FileType>
              <uap:FileType>.dio</uap:FileType>
              <uap:FileType>.docm</uap:FileType>
              <uap:FileType>.dot</uap:FileType>
              <uap:FileType>.dotm</uap:FileType>
              <uap:FileType>.dotx</uap:FileType>
              <uap:FileType>.dps</uap:FileType>
              <uap:FileType>.dpt</uap:FileType>
              <uap:FileType>.drawio</uap:FileType>
              <uap:FileType>.et</uap:FileType>
              <uap:FileType>.ett</uap:FileType>
              <uap:FileType>.fodp</uap:FileType>
              <uap:FileType>.fods</uap:FileType>
              <uap:FileType>.fodt</uap:FileType>
              <uap:FileType>.fxdoom</uap:FileType>
              <uap:FileType>.fxtxt</uap:FileType>
              <uap:FileType>.jsdos</uap:FileType>
              <uap:FileType>.mht</uap:FileType>
              <uap:FileType>.mhtml</uap:FileType>
              <uap:FileType>.otf</uap:FileType>
              <uap:FileType>.otp</uap:FileType>
              <uap:FileType>.ots</uap:FileType>
              <uap:FileType>.ott</uap:FileType>
              <uap:FileType>.pot</uap:FileType>
              <uap:FileType>.potm</uap:FileType>
              <uap:FileType>.potx</uap:FileType>
              <uap:FileType>.pps</uap:FileType>
              <uap:FileType>.ppsm</uap:FileType>
              <uap:FileType>.ppsx</uap:FileType>
              <uap:FileType>.pptm</uap:FileType>
              <uap:FileType>.psb</uap:FileType>
              <uap:FileType>.psd</uap:FileType>
              <uap:FileType>.pxd</uap:FileType>
              <uap:FileType>.stw</uap:FileType>
              <uap:FileType>.sxc</uap:FileType>
              <uap:FileType>.sxi</uap:FileType>
              <uap:FileType>.sxw</uap:FileType>
              <uap:FileType>.wad</uap:FileType>
              <uap:FileType>.woff</uap:FileType>
