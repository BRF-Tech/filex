        <!-- <<< app-kinds: store -->

        <!-- "Start when I sign in". Off until the user turns it on (filex's
             default is off on every build). The parameter is HIDDEN_FLAG from
             src/main.ts, the same flag the NSIS build's Run entry carries: a
             launch nobody asked for stays in the tray. Toggled in Windows
             Settings, Apps, Startup; see the Store branch of the login item in
             main.ts.
             ⚠ No double hyphen anywhere inside an XML comment, the flag's own
             name included: makeappx rejects the whole manifest ("'>' expected"). -->
        <desktop:Extension Category="windows.startupTask" Executable="app\filex.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--hidden">
          <desktop:StartupTask TaskId="filexStartup" Enabled="false" DisplayName="filex" />
        </desktop:Extension>
