# Caddy config for the full filex stack. HTTPS is obtained + renewed
# automatically for real public domains (ports 80/443 must be reachable).
#
# Add-on vhosts (OnlyOffice / Drawio) below default to a harmless
# *.localhost self-signed host when you don't run that add-on. Leave the block
# or delete it — an unused *.localhost vhost costs nothing and requests no cert.

{$FILEX_DOMAIN} {
	encode zstd gzip
	# Large uploads: for S3 only the init/finalize JSON transits the proxy
	# (multipart PUTs go browser→S3 directly); local/SFTP uploads stream through.
	request_body {
		max_size 5GB
	}

	# Everything else → filex. WebSocket/SSE (e.g. /api/ai/mcp) upgrades itself.
	handle {
		reverse_proxy filex:5212 {
			header_up X-Real-IP {remote_host}
		}
	}
}

# OnlyOffice Document Server (onlyoffice profile). The browser loads its iframe
# from here and filex calls it server-to-server, so it needs a real HTTPS host.
# Delete this block if you don't run OnlyOffice.
#
# /filex-frame/* goes to filex: the page the editor's api.js runs in, on the
# document server's own origin instead of in filex's pages
# (docs/ONLYOFFICE.md "The editor in a frame of its own"). Set
# FILEX_ONLYOFFICE_FRAME_ORIGIN=https://<this host> on the filex service to use
# it; filex answers that one path on this host and nothing else. Every other
# path stays the document server's.
{$ONLYOFFICE_DOMAIN} {
	handle /filex-frame/* {
		reverse_proxy filex:5212
	}
	handle {
		reverse_proxy onlyoffice:80
	}
}

# Drawio / diagrams.net editor (drawio profile) — embedded as an iframe, so it
# needs a real HTTPS host. Delete this block if you don't run Drawio.
{$DRAWIO_DOMAIN} {
	reverse_proxy drawio:8080
}

# Apps' own interfaces on an origin of their own (optional) — FILEX_APP_UI_ORIGIN,
# docs/APP-PLUGINS.md "An origin of their own". Point a second host at the same
# filex; filex answers ONLY the interface route (/_appui/…) there, and refuses
# that route on its own host. ⚠ Pick a host on ANOTHER registrable domain
# (apps.example-usercontent.com for files.example.com), so no cookie of filex's
# can ever be sent to it. Then set FILEX_APP_UI_ORIGIN=https://<that host> on
# the filex service. Left commented: without it, interfaces are served from
# filex's own origin, opaque by sandbox (the default). For OnlyOffice, use
# FILEX_ONLYOFFICE_FRAME_ORIGIN and the /filex-frame/* rule in its block below;
# without it the editor's frame is served on this host.
#
# {$FILEX_APP_UI_DOMAIN} {
# 	reverse_proxy filex:5212 {
# 		header_up X-Real-IP {remote_host}
# 	}
# }
