# /root/filex/.env — production environment for demo-fm.brf.sh
#
# Generate the OIDC client secret in Keycloak (auth.brf.sh) → realm
# `brf` → Clients → filex → Credentials. Treat both values like
# real secrets (chmod 600 on this file).

FILEX_OIDC_CLIENT_SECRET=___paste-keycloak-client-secret-here___

# ONLYOFFICE_JWT_SECRET must match what docs.brf.sh container was
# started with (see /root/onlyoffice/.jwt-secret).
ONLYOFFICE_JWT_SECRET=___paste-onlyoffice-jwt-secret___

# Only needed if you switch FILEX_DB_DRIVER to postgres.
POSTGRES_PASSWORD=

# Optional — outbound webhook for notify (replica failures, queue
# stuck, quota events). Leave blank to disable webhook delivery
# (in-app bell still works). Slack/Discord receivers should
# transform the generic payload themselves.
BRF_NOTIFY_TOKEN=
