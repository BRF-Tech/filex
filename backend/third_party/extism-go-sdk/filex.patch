+
+	// filex patch (FILEX.md): the functions this instance calls, kept
+	// across calls. wazero's ExportedFunction builds a new function - with a
+	// new call stack - every time it is asked; a Plugin is used by one
+	// caller at a time, so the maps need no lock.
+	exportFns map[string]api.Function
+	kernelFns map[string]api.Function
+}
+
+// exportFn is the main module's export name, built once per instance (nil
+// when there is none, which is not kept).
+func (p *Plugin) exportFn(name string) api.Function {
+	if f, ok := p.exportFns[name]; ok {
+		return f
+	}
+	f := p.mainModule.ExportedFunction(name)
+	if f != nil {
+		if p.exportFns == nil {
+			p.exportFns = map[string]api.Function{}
+		}
+		p.exportFns[name] = f
+	}
+	return f
+}
+
+// kernelFn is the extism kernel's function name, built once per instance.
+func (p *Plugin) kernelFn(name string) api.Function {
+	if f, ok := p.kernelFns[name]; ok {
+		return f
+	}
+	f := p.extism.ExportedFunction(name)
+	if f != nil {
+		if p.kernelFns == nil {
+			p.kernelFns = map[string]api.Function{}
+		}
+		p.kernelFns[name] = f
+	}
+	return f
 }
 
