<p>{{ 'mail.greeting' | t }}</p>
<p>
{%- if item.kind == "folder" -%}
  {%- if site.name != blank %}{{ 'mail.share.intro_folder_site' | t: site: site.name }}{% else %}{{ 'mail.share.intro_folder' | t }}{% endif -%}
{%- else -%}
  {%- if site.name != blank %}{{ 'mail.share.intro_file_site' | t: site: site.name }}{% else %}{{ 'mail.share.intro_file' | t }}{% endif -%}
{%- endif -%}
</p>
<div class="facts"><p>
{%- if item.kind == "folder" %}{{ 'mail.label.folder' | t: name: item.name }}{% else %}{{ 'mail.label.file' | t: name: item.name }}{% endif -%}
{%- if item.kind != "folder" and item.size > 0 %}<br>{{ 'mail.label.size' | t: size: item.size_text }}{% endif -%}
</p></div>
<p>{{ 'mail.share.download' | t }}<br>
<a class="btn" href="{{ link.url }}" data-text="href">{{ 'mail.share.button' | t }}</a></p>
<p class="link" data-text="skip">{{ link.url | link_to: link.url }}</p>
{%- if link.pin != blank %}
<p><strong>{{ 'mail.label.pin' | t: pin: link.pin }}</strong></p>
{%- elsif link.pin_withheld %}
<p class="note">{{ 'mail.label.pin_separately' | t }}</p>
{%- endif %}
<p class="note">{% if link.days_left > 0 %}{{ 'mail.valid_days' | t: count: link.days_left }}{% else %}{{ 'mail.no_expiry' | t }}{% endif %}</p>
