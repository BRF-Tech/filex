      "thumbnail": {
        "custom": false,
        "off": [],
        "on": []
      }
    },
    {
      "ext": "jar",
      "mime": "application/java-archive",
      "open": {
        "custom": false,
        "off": [],
        "on": [
          {
            "id": "builtin"
          }
        ]
      },
      "thumbnail": {
        "custom": false,
        "off": [],
        "on": [
          {
            "app": "pkglist",
            "id": "app:pkglist",
            "label": {
              "en": "Package contents",
              "tr": "Paket içeriği"
            },
            "version": "0.1.0"
          }
        ]
