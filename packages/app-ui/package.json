{
  "name": "@brftech/filex-app-ui",
  "version": "0.51.0",
  "description": "filex app interface SDK: the bridge between an app's own sandboxed interface and filex (open, save, dirty, call the app's module)",
  "type": "module",
  "main": "./dist/filex-app-ui.js",
  "module": "./dist/filex-app-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/filex-app-ui.js"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "import": "./src/protocol.ts"
    },
    "./iife": "./dist/filex-app-ui.iife.js"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:no-dts": "vite build",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "filex",
    "file-manager",
    "plugin",
    "sdk",
    "brftech"
  ],
  "author": "BRF Tech <hello@brf.sh>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brf-tech/filex.git",
    "directory": "packages/app-ui"
  }
}
