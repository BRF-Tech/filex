+  # ── AUR (filex-app-bin) ─────────────────────────────────────────────
+  #
+  # The PKGBUILD repackages the .deb just attached, so it runs after `desktop`
+  # and hashes THAT file. packaging/aur/update-pkgbuild.sh sets pkgver and the
+  # checksums and regenerates .SRCINFO; both are kept as a run artifact either
+  # way. The push needs the SSH key registered with the AUR account — without
+  # it the run says so (warning + summary) instead of pretending.
+  aur:
+    name: AUR package (filex-app-bin)
+    needs: desktop
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - name: PKGBUILD and .SRCINFO for this tag
+        shell: bash
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          gh release download "${GITHUB_REF_NAME}" -p filex-desktop-amd64.deb -D "$RUNNER_TEMP/rel"
+          bash packaging/aur/update-pkgbuild.sh "${GITHUB_REF_NAME}" --deb "$RUNNER_TEMP/rel/filex-desktop-amd64.deb"
+          cat packaging/aur/filex-app-bin/.SRCINFO
+      - uses: actions/upload-artifact@v4
+        with:
+          name: aur-filex-app-bin
+          path: |
+            packaging/aur/filex-app-bin/PKGBUILD
+            packaging/aur/filex-app-bin/.SRCINFO
+          include-hidden-files: true
+      - name: Push to the AUR
+        shell: bash
+        env:
+          AUR_SSH_PRIVATE_KEY: ${{ secrets.AUR_SSH_PRIVATE_KEY }}
+        run: |
+          set -euo pipefail
+          if [ -z "${AUR_SSH_PRIVATE_KEY:-}" ]; then
+            msg="AUR_SSH_PRIVATE_KEY is not set: filex-app-bin was NOT pushed to the AUR. PKGBUILD and .SRCINFO are in this run's artifacts."
+            echo "::warning title=AUR: not pushed::$msg"
+            echo "### AUR: not pushed (no SSH key)" >> "$GITHUB_STEP_SUMMARY"
+            echo "$msg" >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+          # The committed PKGBUILD is a template (SKIP checksums) until the
+          # step above has rewritten it for this tag; never push that.
+          if grep -q "'SKIP'" packaging/aur/filex-app-bin/PKGBUILD; then
+            echo "PKGBUILD still carries SKIP checksums — not pushing" >&2
+            exit 1
+          fi
+          install -d -m 700 ~/.ssh
+          printf '%s\n' "$AUR_SSH_PRIVATE_KEY" > ~/.ssh/aur && chmod 600 ~/.ssh/aur
+          ssh-keyscan -t ed25519 aur.archlinux.org >> ~/.ssh/known_hosts 2>/dev/null
+          export GIT_SSH_COMMAND="ssh -i $HOME/.ssh/aur -o IdentitiesOnly=yes"
+          git clone ssh://aur@aur.archlinux.org/filex-app-bin.git "$RUNNER_TEMP/aur"
+          cp packaging/aur/filex-app-bin/PKGBUILD packaging/aur/filex-app-bin/.SRCINFO "$RUNNER_TEMP/aur/"
+          cd "$RUNNER_TEMP/aur"
+          git add PKGBUILD .SRCINFO
+          if git diff --cached --quiet; then echo "AUR already at ${GITHUB_REF_NAME}"; exit 0; fi
+          git -c user.name="BRF Teknoloji" -c user.email="security@brf.sh" commit -q -m "Update to ${GITHUB_REF_NAME#v}"
+          git push origin HEAD:master
+          echo "### AUR: pushed ${GITHUB_REF_NAME#v}" >> "$GITHUB_STEP_SUMMARY"
