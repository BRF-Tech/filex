+publisher="${id%%.*}"
+name="${id#*.}"
+first=$(printf '%s' "${id:0:1}" | tr '[:upper:]' '[:lower:]')
+if ! answer=$(gh api "repos/$repo/contents/manifests/$first/$publisher/$name" --jq 'length' 2>&1); then
