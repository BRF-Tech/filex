+            e2e/.artifacts
+          include-hidden-files: true
+          if-no-files-found: ignore
+          retention-days: 7
+
+  # ── Images ──────────────────────────────────────────────────────────────
   docker:
     name: Docker image builds
     runs-on: ubuntu-latest
-    needs: [backend, frontend]
-    # ⚠ No `if:`. On a push, on a PR and when the release calls this workflow
-    # as its gate, the images are built - see workflow_call above for why.
+    # ⚠ No `if:`: on a push and on a pull request both images are built. A
+    # Dockerfile that cannot build is found on the commit that broke it, long
+    # before a release's dry run (which builds them again, and is what a tag
+    # run promotes).
     steps:
