+
+  # ── The verdict ─────────────────────────────────────────────────────────
+  # One job that is green only when every part of this run's profile was:
+  # what the release gate and a tag's `verify` ask for by name
+  # (scripts/ci-parts.mjs, completeName). `always()`: a red part must turn
+  # this red, not skip it - a skipped verdict reads as no verdict.
+  all:
+    name: All tests (${{ needs.plan.outputs.profile }})
+    needs: [plan, vet, go, race, shards, engines, frontend, typecheck, desktop, docs, build, browser, playwright, playwright-ds, playwright-extra, docker]
+    if: always()
