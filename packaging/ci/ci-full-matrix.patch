+          bad=$(jq -r --arg p "$PROFILE" '
+            to_entries[]
+            | select(.value.result != "success")
+            | select(($p == "pr" and .value.result == "skipped" and (.key == "race" or .key == "playwright-ds" or .key == "playwright-extra")) | not)
