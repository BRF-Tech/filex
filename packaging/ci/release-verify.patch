+/** Every job of a workflow, by name. */
+function jobNames(lines: string[]): string[] {
+  const start = lines.findIndex((l) => l === 'jobs:');
+  return lines.slice(start + 1).map((l) => /^ {2}([A-Za-z0-9_-]+):\s*$/.exec(l)?.[1]).filter((n): n is string => !!n);
