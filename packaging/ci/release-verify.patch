+function topLevelTerms(cond: string): string[] {
+  let s = cond.replace(/^ {4}if:\s*/, '').replace(/^\$\{\{\s*/, '').replace(/\s*\}\}\s*$/, '');
+  for (let prev = ''; prev !== s; ) {
+    prev = s;
+    s = s.replace(/\([^()]*\)/g, '[]');
+  }
+  return s.split('&&').map((t) => t.trim());
