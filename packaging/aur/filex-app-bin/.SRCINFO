pkgbase = filex-app-bin
	pkgdesc = filex desktop app: your filex server in a window, with browser sign-in and background folder sync
	pkgver = 0.44.0
	pkgrel = 1
	url = https://filex.sh
	arch = x86_64
	license = MIT
	depends = gtk3
	depends = libnotify
	depends = nss
	depends = libxss
	depends = libxtst
	depends = xdg-utils
	depends = at-spi2-core
	depends = util-linux-libs
	depends = libsecret
	depends = alsa-lib
	optdepends = gnome-keyring: keeps the sign-in (KWallet works too); without a keyring filex refuses to store it
	optdepends = libappindicator-gtk3: tray icon on desktops without StatusNotifier support
	provides = filex-app
	conflicts = filex-app
	noextract = filex-desktop-0.44.0-amd64.deb
	options = !strip
	options = !debug
	source = filex-desktop-0.44.0-amd64.deb::https://github.com/BRF-Tech/filex/releases/download/v0.44.0/filex-desktop-amd64.deb
	source = LICENSE-0.44.0::https://raw.githubusercontent.com/BRF-Tech/filex/v0.44.0/LICENSE
	sha256sums = SKIP
	sha256sums = SKIP

pkgname = filex-app-bin
